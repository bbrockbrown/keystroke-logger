FLASK_ENV=development                               # for debugging purposes
FLASK_WEBSITE=https://websitepullingdata.com        # some site you may want to display keystroke data onKEYSTROKE_SYNC_URL=https://www.example.com/api/keystrokes   # portfolio endpoint sync.py pushes to (use the final, non-redirecting host)
KEYSTROKE_SYNC_TOKEN=                                       # shared secret; must match KEYSTROKE_SYNC_TOKEN in the portfolio's Vercel env
